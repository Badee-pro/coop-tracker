# Copy this file to .env (same folder) and fill in the values. .env is gitignored.

# In Edge DevTools > Network, click the "applications.htm?page=1&sort..." request,
# then Headers > Request Headers > Cookie. Copy the whole value.
WW_COOKIE=

# Same request: right-click it > Copy > Copy URL.
WW_APPLICATIONS_URL=

# How often to sync automatically while the app is running (0 = only when you click Sync now).
WW_SYNC_MINUTES=0
